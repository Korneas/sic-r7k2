{
  "framework": null,
  "installCommand": "true",
  "buildCommand": "printf 'window.MAPBOX_TOKEN = \"%s\";\\n' \"$MAPBOX_PK\" > web/config.js && curl -fsSL https://github.com/Korneas/sic-r7k2/releases/download/db/web-data.tar.gz | tar xz -C web",
  "outputDirectory": "web",
  "functions": {
    "api/manual.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
